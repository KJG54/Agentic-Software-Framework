{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/contracts/schemas/v1/adr.schema.json",
  "title": "Architecture Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "context",
    "decision",
    "consequences",
    "date"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^ADR-[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "accepted", "superseded", "deprecated"] },
    "context": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "consequences": { "type": "string", "minLength": 1 },
    "options_considered": { "type": "array", "items": { "type": "string" } },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "additionalProperties": true
}
