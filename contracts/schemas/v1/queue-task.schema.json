{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/contracts/schemas/v1/queue-task.schema.json",
  "title": "Queue Task",
  "type": "object",
  "required": ["schema_version", "id", "title", "files_touched_estimate"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
      "default": []
    },
    "files_touched_estimate": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "branch": { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": true
}
